# ============================================================
#  EDIT THESE VALUES, then run ./setup.sh
# ============================================================

# Space-separated list of ALL domains that point to this server.
# The FIRST one is treated as the primary domain.
# Example: DOMAINS="app.yourdomain.com customer1.com customer2.com"
DOMAINS="salmon.makupro.fi"

# Email used by Let's Encrypt for expiry notices.
CERTBOT_EMAIL="gaopingxin0315@gmail.com"

# Git repo to deploy (leave as-is unless you forked it).
REPO_URL="https://github.com/pingxg/zebra-factory.git"

# Where the app lives on the server. Usually fine to leave as-is.
APP_DIR="/opt/zebra-factory"

# Internal port gunicorn binds to (Nginx proxies to this). Leave as-is.
APP_PORT="8888"
